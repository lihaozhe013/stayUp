{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StayUp",
  "version": "0.1.0",
  "identifier": "dev.stayup.desktop",
  "build": {
    "beforeDevCommand": "bun dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StayUp",
        "width": 1180,
        "height": 780,
        "minWidth": 840,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Manage background apps",
    "longDescription": "Run the apps you depend on quietly in the background.",
    "resources": [
      "resources/winsw/WinSW.NET461.exe",
      "resources/winsw/LICENSE.txt"
    ],
    "icon": ["../icons/icon.ico", "../icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "dialog": {
      "all": true
    },
    "opener": {
      "requireLiteralLeadingDot": false
    }
  }
}
